# Canonical site URL (no trailing slash). Set in Vercel Project → Environment Variables.
# Example: https://calicon.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Search Console verification token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Google Analytics 4. Leave unset to disable all third-party analytics.
# Honors Do Not Track. Never required for the site to function.
# Events measure qualified-inquiry behavior only (no form contents or PII).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional first-party event endpoint (POST JSON). Leave unset to disable.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Contact form delivery (Resend). Without these, enquiries are logged server-side only.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Calicon <onboarding@resend.dev>
# CONTACT_INBOX_EMAIL=you@example.com
