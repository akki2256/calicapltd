# Canonical site URL (no trailing slash). Set in Vercel Project → Environment Variables.
# Example: https://calicon.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Search Console verification token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form delivery (Resend). Without these, enquiries are logged server-side only.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Calicon <onboarding@resend.dev>
# CONTACT_INBOX_EMAIL=you@example.com
